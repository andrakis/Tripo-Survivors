{
  "name": "tripo-survivors",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A Survivors-like in React + Three.js, built as the demo vehicle for Tripo AI model-import tutorials.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "npm run build && vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "shot": "node scripts/shot.mjs",
    "verify": "node scripts/drive.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.2",
    "playwright": "1.61.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^3.0.0"
  }
}
